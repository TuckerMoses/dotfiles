# ── Lifeline ──────────────────────────────────────────────────────────
# Everything that keeps the machine reachable when nobody is at it: SSH,
# Tailscale, the firewall holes for both, no sleep, a watchdog, and a guard
# that refuses to build a config which would cut SSH or Tailscale access.
#
# Do not edit this file over a remote session without `safe-switch`.
{
  config,
  lib,
  pkgs,
  ...
}:
let
  cfg = config.lifeline;

  lifeline-watchdog = pkgs.writeShellApplication {
    name = "lifeline-watchdog";
    runtimeInputs = [
      config.systemd.package
      config.services.tailscale.package
      pkgs.coreutils
      pkgs.iproute2
      pkgs.jq
    ];
    text = ''
      dir=/var/lib/lifeline
      fails_file=/run/lifeline-fails
      mkdir -p "$dir"

      # A safe-switch or trial boot has its own recovery; leave it alone.
      [[ ! -e /run/safe-rebuild/pending ]] || exit 0
      [[ ! -e /run/safe-rebuild/trial ]] || exit 0

      healthy() {
        local st
        [[ -n "$(ip -4 route show default 2>/dev/null)" ]] || { echo "no default route"; return 1; }
        systemctl is-active --quiet sshd.service || { echo "sshd is not running"; return 1; }
        systemctl is-active --quiet tailscaled.service || { echo "tailscaled is not running"; return 1; }
        st="$(timeout 20 tailscale status --json 2>/dev/null | jq -r '.BackendState // "unknown"' || true)"
        # NeedsLogin and NeedsMachineAuth wait for a person; a reboot cannot fix them.
        case $st in
          Running | NeedsLogin | NeedsMachineAuth) ;;
          *) echo "tailscale state is $st"; return 1 ;;
        esac
      }

      if reason="$(healthy)"; then
        rm -f "$fails_file"
        echo 0 > "$dir/reboots"
        exit 0
      fi

      fails=0
      [[ ! -r $fails_file ]] || fails="$(cat "$fails_file")"
      [[ $fails =~ ^[0-9]+$ ]] || fails=0
      fails=$((fails + 1))
      echo "$fails" > "$fails_file"
      echo "lifeline-watchdog: no way in ($reason); failure $fails"

      # Failures are two minutes apart: restart services from about 7 minutes after boot...
      if (( fails >= 2 && fails < 8 && fails % 2 == 0 )); then
        echo "lifeline-watchdog: restarting the network and Tailscale"
        systemctl start sshd.service || true
        systemctl restart NetworkManager.service || true
        systemctl restart tailscaled.service || true
      fi

      # ...and reboot about 19 minutes after boot, but never more than 3 times
      # without a healthy check in between (a dead router must not loop it).
      if (( fails >= 8 )); then
        reboots=0
        [[ ! -r $dir/reboots ]] || reboots="$(cat "$dir/reboots")"
        [[ $reboots =~ ^[0-9]+$ ]] || reboots=0
        if (( reboots >= 3 )); then
          echo "lifeline-watchdog: already rebooted $reboots times without recovering; not rebooting again"
          exit 0
        fi
        echo $((reboots + 1)) > "$dir/reboots"
        echo "lifeline-watchdog: rebooting (reboot $((reboots + 1)) of 3)"
        systemctl reboot
      fi
    '';
  };
in
{
  options.lifeline = {
    user = lib.mkOption {
      type = lib.types.str;
      description = "The admin account that logs in over SSH.";
    };
    authorizedKeys = lib.mkOption {
      type = lib.types.listOf lib.types.str;
      description = "Public keys allowed to log in as the admin account.";
    };
    installDiskModel = lib.mkOption {
      type = lib.types.str;
      default = "";
      description = ''
        The model string `lsblk` shows for the disk install.sh may erase, exactly as printed.
        install.sh refuses to go on if the disk it would erase reports anything else.
        Empty skips the check (the VM).
      '';
    };
    flakeAttr = lib.mkOption {
      type = lib.types.str;
      description = "This machine's name under nixosConfigurations in the flake.";
    };
    flakeDir = lib.mkOption {
      type = lib.types.str;
      default = "/home/${cfg.user}/dotfiles";
      description = "Where the checkout of this repo lives on the machine.";
    };
  };

  config = {
    # ── Account ───────────────────────────────────────────────────────
    users.users.${cfg.user} = {
      isNormalUser = true;
      extraGroups = [
        "wheel"
        "networkmanager"
      ];
      openssh.authorizedKeys.keys = cfg.authorizedKeys;
    };
    # Key-only logins have no password to type, so sudo must not ask for one.
    security.sudo.wheelNeedsPassword = false;

    # ── SSH ───────────────────────────────────────────────────────────
    # Port 22, plus 2222: with Tailscale SSH on, Tailscale answers port 22 on
    # the tailnet address itself, so OpenSSH is only reachable there on 2222.
    # That keeps two independent ways in from outside the house.
    services.openssh = {
      enable = true;
      openFirewall = true;
      ports = [
        22
        2222
      ];
      settings = {
        PasswordAuthentication = false;
        KbdInteractiveAuthentication = false;
        PermitRootLogin = "no";
      };
    };

    # ── Tailscale ─────────────────────────────────────────────────────
    services.tailscale = {
      enable = true;
      openFirewall = true;
    };

    # ── Network ───────────────────────────────────────────────────────
    networking.networkmanager.enable = true;
    networking.firewall = {
      enable = true;
      trustedInterfaces = [ "tailscale0" ];
    };

    # ── Never sleep ───────────────────────────────────────────────────
    systemd.targets = {
      sleep.enable = false;
      suspend.enable = false;
      hibernate.enable = false;
      hybrid-sleep.enable = false;
    };

    # ── Keep booting, and reset if hung ───────────────────────────────
    # A failed mount must not stop at an emergency prompt before the network.
    systemd.enableEmergencyMode = false;
    # A kernel panic or a failed early boot restarts the machine instead of
    # sitting there; after a trial boot that lands back on the old system.
    # Oopses and soft lockups are not made into panics: panic reboots have no
    # cap, so a repeating driver fault would reboot forever.
    boot.kernelParams = [
      "panic=30"
      "boot.panic_on_fail"
    ];
    # The board's watchdog resets the machine if systemd stops responding.
    systemd.settings.Manager = {
      RuntimeWatchdogSec = "60s";
      RebootWatchdogSec = "5min";
    };

    # ── Reachable, not just alive ─────────────────────────────────────
    # The watchdog above only sees a hung systemd. This one sees a machine that
    # is up but has no way in (router late after a power cut, a wedged NIC,
    # tailscaled stuck): it restarts networking, then reboots as a last resort,
    # at most three times in a row.
    systemd.services.lifeline-watchdog = {
      description = "Recover the network and Tailscale if the machine has no way in";
      serviceConfig = {
        Type = "oneshot";
        ExecStart = "${lifeline-watchdog}/bin/lifeline-watchdog";
      };
    };
    systemd.timers.lifeline-watchdog = {
      wantedBy = [ "timers.target" ];
      timerConfig = {
        OnBootSec = "5min";
        OnUnitActiveSec = "2min";
        AccuracySec = "10s";
      };
    };

    # ── Memory pressure ───────────────────────────────────────────────
    # A runaway workload must not starve the way in: compressed swap, an early
    # killer for everything else, and the network path last in line. neither SSH
    # daemon (sshd, tailscaled) gets a score: their sessions (login shells,
    # runaway jobs) would inherit it and become unkillable.
    zramSwap.enable = true;
    systemd.oomd = {
      enable = true;
      enableRootSlice = true;
      enableUserSlices = true;
    };
    systemd.services.sshd.serviceConfig.ManagedOOMPreference = "omit";
    systemd.services.NetworkManager.serviceConfig = {
      OOMScoreAdjust = -500;
      ManagedOOMPreference = "omit";
    };
    systemd.services.tailscaled.serviceConfig.ManagedOOMPreference = "omit";

    # ── Nothing changes without the owner ─────────────────────────────
    system.autoUpgrade.enable = false;

    # ── Lockout guard ─────────────────────────────────────────────────
    # These fail the build, so a mistake elsewhere cannot reach the machine.
    assertions = [
      {
        assertion = config.services.openssh.enable && config.services.openssh.openFirewall;
        message = "lifeline: OpenSSH must stay enabled and open in the firewall.";
      }
      {
        assertion =
          builtins.elem 22 config.services.openssh.ports && builtins.elem 2222 config.services.openssh.ports;
        message = "lifeline: OpenSSH must keep listening on ports 22 and 2222.";
      }
      {
        assertion = config.services.tailscale.enable;
        message = "lifeline: Tailscale must stay enabled.";
      }
      {
        assertion = cfg.authorizedKeys != [ ];
        message = "lifeline: at least one SSH key must be authorized.";
      }
      {
        assertion =
          config.users.users.${cfg.user}.openssh.authorizedKeys.keys != [ ]
          && builtins.elem "wheel" config.users.users.${cfg.user}.extraGroups;
        message = "lifeline: the admin account must keep its SSH key and sudo.";
      }
      {
        assertion = !config.security.sudo.wheelNeedsPassword;
        message = "lifeline: sudo must not ask for a password (logins are key-only).";
      }
      {
        assertion = config.networking.networkmanager.enable;
        message = "lifeline: NetworkManager must stay enabled.";
      }
      {
        assertion = !config.systemd.targets.suspend.enable && !config.systemd.targets.sleep.enable;
        message = "lifeline: sleep and suspend must stay disabled.";
      }
      {
        assertion = !config.system.autoUpgrade.enable;
        message = "lifeline: automatic upgrades must stay off.";
      }
    ];
  };
}
