# ── Lifeline ──────────────────────────────────────────────────────────
# Everything that keeps the machine reachable when nobody is at it: SSH,
# Tailscale, the firewall holes for both, no sleep, a watchdog, and a guard
# that refuses to build a config which would cut any of them.
#
# Do not edit this file over a remote session without `safe-switch`.
{
  config,
  lib,
  ...
}:
let
  cfg = config.lifeline;
in
{
  options.lifeline = {
    user = lib.mkOption {
      type = lib.types.str;
      description = "The admin account that logs in over SSH.";
    };
    authorizedKeys = lib.mkOption {
      type = lib.types.listOf lib.types.str;
      description = "Public keys allowed to log in as the admin account.";
    };
    flakeAttr = lib.mkOption {
      type = lib.types.str;
      description = "This machine's name under nixosConfigurations in the flake.";
    };
    flakeDir = lib.mkOption {
      type = lib.types.str;
      default = "/home/${cfg.user}/dotfiles";
      description = "Where the checkout of this repo lives on the machine.";
    };
  };

  config = {
    # ── Account ───────────────────────────────────────────────────────
    users.users.${cfg.user} = {
      isNormalUser = true;
      extraGroups = [
        "wheel"
        "networkmanager"
      ];
      openssh.authorizedKeys.keys = cfg.authorizedKeys;
    };
    # Key-only logins have no password to type, so sudo must not ask for one.
    security.sudo.wheelNeedsPassword = false;

    # ── SSH ───────────────────────────────────────────────────────────
    # Port 22, plus 2222: with Tailscale SSH on, Tailscale answers port 22 on
    # the tailnet address itself, so OpenSSH is only reachable there on 2222.
    # That keeps two independent ways in from outside the house.
    services.openssh = {
      enable = true;
      openFirewall = true;
      ports = [
        22
        2222
      ];
      settings = {
        PasswordAuthentication = false;
        KbdInteractiveAuthentication = false;
        PermitRootLogin = "no";
      };
    };

    # ── Tailscale ─────────────────────────────────────────────────────
    services.tailscale = {
      enable = true;
      openFirewall = true;
    };

    # ── Network ───────────────────────────────────────────────────────
    networking.networkmanager.enable = true;
    networking.firewall = {
      enable = true;
      trustedInterfaces = [ "tailscale0" ];
    };

    # ── Never sleep ───────────────────────────────────────────────────
    systemd.targets = {
      sleep.enable = false;
      suspend.enable = false;
      hibernate.enable = false;
      hybrid-sleep.enable = false;
    };

    # ── Keep booting, and reset if hung ───────────────────────────────
    # A failed mount must not stop at an emergency prompt before the network.
    systemd.enableEmergencyMode = false;
    # A kernel panic or a failed early boot restarts the machine instead of
    # sitting there; after a trial boot that lands back on the old system.
    boot.kernelParams = [
      "panic=30"
      "boot.panic_on_fail"
    ];
    # The board's watchdog resets the machine if systemd stops responding.
    systemd.settings.Manager = {
      RuntimeWatchdogSec = "60s";
      RebootWatchdogSec = "5min";
    };

    # ── Nothing changes without the owner ─────────────────────────────
    system.autoUpgrade.enable = false;

    # ── Lockout guard ─────────────────────────────────────────────────
    # These fail the build, so a mistake elsewhere cannot reach the machine.
    assertions = [
      {
        assertion = config.services.openssh.enable && config.services.openssh.openFirewall;
        message = "lifeline: OpenSSH must stay enabled and open in the firewall.";
      }
      {
        assertion =
          builtins.elem 22 config.services.openssh.ports && builtins.elem 2222 config.services.openssh.ports;
        message = "lifeline: OpenSSH must keep listening on ports 22 and 2222.";
      }
      {
        assertion = config.services.tailscale.enable;
        message = "lifeline: Tailscale must stay enabled.";
      }
      {
        assertion = cfg.authorizedKeys != [ ];
        message = "lifeline: at least one SSH key must be authorized.";
      }
      {
        assertion =
          config.users.users.${cfg.user}.openssh.authorizedKeys.keys != [ ]
          && builtins.elem "wheel" config.users.users.${cfg.user}.extraGroups;
        message = "lifeline: the admin account must keep its SSH key and sudo.";
      }
      {
        assertion = !config.security.sudo.wheelNeedsPassword;
        message = "lifeline: sudo must not ask for a password (logins are key-only).";
      }
      {
        assertion = config.networking.networkmanager.enable;
        message = "lifeline: NetworkManager must stay enabled.";
      }
      {
        assertion = !config.systemd.targets.suspend.enable && !config.systemd.targets.sleep.enable;
        message = "lifeline: sleep and suspend must stay disabled.";
      }
      {
        assertion = !config.system.autoUpgrade.enable;
        message = "lifeline: automatic upgrades must stay off.";
      }
    ];
  };
}
