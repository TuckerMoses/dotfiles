#!/bin/sh
# Jump to an agent session: your move first, then hottest; description previewed below.
# Needs fzf and herdr-summarize on PATH (or alongside this script).
here=$(cd "$(dirname "$0")" && pwd)
hs="$here/herdr-summarize"; [ -x "$hs" ] || hs=herdr-summarize
pick=$("$hs" list 2>/dev/null | awk -F'\t' '{ printf "%s\t%-5s %-8s %-13s %s\n", $1, $2, substr($3,1,8), $4, $5 }' | fzf \
  --delimiter '\t' --with-nth 2 \
  --header "$(printf '%-5s %-8s %-13s %-34s %s' heat space ball label 'enter jump · esc close')" \
  --preview "$hs show {1} | fold -s -w \$FZF_PREVIEW_COLUMNS" --preview-window 'down,40%' \
  --layout reverse --info inline-right --prompt 'recent › ' \
  --color 'header:#6c7086,pointer:#f5c2e7,hl:#f9e2af') || exit 0
herdr agent focus "$(printf '%s' "$pick" | cut -f1)" >/dev/null
